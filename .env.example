# =============================================================
#  NurseBot 護理智慧助手 — 環境變數設定
#  複製此檔案為 .env 並填入您的金鑰
# =============================================================

# --- LINE Bot 設定 ---
# 請至 https://developers.line.biz/ 建立 Messaging API Channel
LINE_CHANNEL_SECRET=YOUR_CHANNEL_SECRET
LINE_CHANNEL_ACCESS_TOKEN=YOUR_CHANNEL_ACCESS_TOKEN

# --- 資料來源模式 ---
# true  = 使用內建模擬資料（開發測試用，不需 EBSCO 帳號）
# false = 使用 EBSCO EDS API（需要有效訂閱帳號）
USE_MOCK_DATA=true

# --- EBSCO EDS API 設定（USE_MOCK_DATA=false 時必填）---
# 請聯繫貴機構 EBSCO 管理員取得 API 帳號
EBSCO_PROFILE_ID=
EBSCO_USER_ID=
EBSCO_PASSWORD=

# --- 伺服器設定 ---
PORT=5000
